# Local/private demo. Never commit a real API key.
AIOPS_PROVIDER=disabled
# Set provider=openai and enter a key locally to deliberately enable LLM mode.
AIOPS_API_KEY=
# OPENAI_API_KEY is also accepted from the process environment.
AIOPS_CHAT_MODEL=gpt-4.1-mini
AIOPS_EMBEDDING_MODEL=text-embedding-3-small
AIOPS_EMBEDDING_DIMENSIONS=1536
AIOPS_DATABASE_URL=sqlite:///./ai_ops.db
AIOPS_KNOWLEDGE_DB=./data/knowledge.sqlite3
AIOPS_TIMEOUT_SECONDS=15
AIOPS_MAX_DURATION=45
AIOPS_MAX_MODEL_CALLS=4
AIOPS_MAX_TOOL_CALLS=6
AIOPS_MAX_GRAPH_STEPS=24
AIOPS_MAX_OUTPUT_TOKENS=1800
AIOPS_CONCURRENCY=2
AIOPS_MAX_PENDING=32
